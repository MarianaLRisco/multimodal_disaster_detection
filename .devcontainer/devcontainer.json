{
    "name": "multimodalVLMs",
    "build": {
      "dockerfile": "../Dockerfile"
    },
    "runArgs": [
      "--gpus=all",
      "--shm-size=10g"
    ],
    "remoteUser": "root",
    "mounts": ["source=/home/mariana/Datasets,target=${containerWorkspaceFolder}/data,type=bind,consistency=cached"],
    "customizations": {
        "vscode": {
          "extensions": [
            "ms-python.python",
            "ms-toolsai.jupyter",
            "ms-toolsai.vscode-jupyter-cell-tags",
            "ms-toolsai.jupyter-keymap",
            "ms-toolsai.jupyter-renderers",
            "ms-toolsai.vscode-jupyter-slideshow",
            "ms-python.vscode-pylance"  
          ]
        }
      }
    
  }
   